    {
      "slug": "db-integrity",
      "domain": "db",
      "command": "integrity",
      "group": "Inspect",
      "help": "The instance-integrity census: the whole-instance sweeps — header claims vs walked truth, pointer resolution, declared-type grammar, the declaration-driven index audit (register + feed), hollow sub-records, the DD census, key uniqueness, and the full-depth sub-file descent — as counts with denominators per file (class, file, count, content-fold rows), never a pass/fail verdict.",
      "engine": "read",
      "mutates": false,
      "flags": [
        "engine",
        "lock-wait",
        "timeout",
        "to",
        "pace",
        "out"
      ],
