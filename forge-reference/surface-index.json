      "url": "/forge-reference/reference/db/db-integrity/"
    },
    {
      "slug": "db-integrity-compare",
      "domain": "db",
      "command": "integrity-compare",
      "group": "Inspect",
      "help": "Compare an integrity artifact against a named expectation, OFFLINE: a prior committed run of the same instance (any row difference is the red delta outcome) and/or the shipped-state ledger (one-sided excess is the attention outcome, never red). Speaks four pinned outcome words: clean, delta, attention, stopped.",
      "mutates": false,
      "flags": [
        "base",
        "assert",
        "ledger"
      ],
      "example": "v db integrity-compare ./integrity-today --base ./integrity-baseline",
      "url": "/forge-reference/reference/db/db-integrity-compare/"
    },
    {
      "slug": "db-integrity-report",
      "domain": "db",
      "command": "integrity-report",
      "group": "Inspect",
      "help": "Explain one integrity artifact's pointer findings by TARGET (VD-D109): dangling mass joined to each target file's own header-ledger row — a header-divergent target is ONE finding with its mechanism shown, a healthy target is the class worth eyes, with the source list attached either way — plus the malformed split (type-history vs live-resolving), which has no target to attribute.",
      "engine": "read",
      "mutates": false,
      "flags": [
        "engine",
        "lock-wait",
        "timeout"
      ],
      "example": "v db integrity-report ./integrity-today --engine vehu",
      "url": "/forge-reference/reference/db/db-integrity-report/"
    },
    {
