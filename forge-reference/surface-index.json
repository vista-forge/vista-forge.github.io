    {
      "slug": "db-selection",
      "domain": "db",
      "command": "selection",
      "group": "Inspect",
      "help": "The SELECTION object: which tables to extract, at any depth, with a projection and filter per table — compiled into the run set 'v db bundle' runs. Saved, diffable and re-runnable; not a query language.",
      "engine": "none",
      "mutates": false,
      "example": "v db selection --help",
      "url": "/forge-reference/reference/db/db-selection/"
    },
    {
      "slug": "db-selection-compile",
      "domain": "db",
      "command": "selection compile",
      "help": "Compile a selection into the run set 'v db bundle' runs: each table entry becomes one 'rows' invocation with its projection and filter, each passthrough entry is carried unchanged, and the compiled set records which selection (and which catalog build, under which rule) produced it. Every entry is resolved against the generated command contract; a problem refuses and writes nothing.",
      "engine": "none",
      "mutates": false,
      "flags": [
        "out",
        "catalog"
      ],
      "example": "v db selection compile sets/dd-bundle-selection.toml --out ./set.toml",
      "url": "/forge-reference/reference/db/db-selection-compile/"
    },
    {
      "slug": "db-selection-size",
      "domain": "db",
      "command": "selection size",
      "help": "Size a selection BEFORE it is extracted (VD-D119/VD-D120): each table's N from the committed catalog build at zero engine cost, its mean row bytes from one spread probe at the component's own projection, tier and filter, widened until the sample-dispersion band is inside ±10 % or 5 visits are spent — an interval per component and for the whole, never a point; a selection with an unsizable component refuses before any engine visit and never holds a verdict.",
      "engine": "read",
      "mutates": false,
      "flags": [
        "engine",
        "lock-wait",
        "timeout",
        "catalog",
        "integrity",
        "prior",
        "cap",
        "out"
      ],
      "example": "v db selection size sets/dd-bundle-selection.toml --catalog ~/data/v-db-catalog/vehu-2026-08-24-s4 --integrity baselines/integrity/vehu --prior ~/data/v-db-bundles/vehu-2026-08-24-s5-legA-committed --engine vehu",
      "url": "/forge-reference/reference/db/db-selection-size/"
    },
    {
      "slug": "db-selection-explain",
      "domain": "db",
      "command": "selection explain",
      "help": "Report what a selection WOULD compile to — every entry, its kind, the verb and arguments it becomes, and the lineage the compile step would attach — without writing anything. If the selection has problems, all of them rather than the first.",
      "engine": "none",
      "mutates": false,
      "flags": [
        "catalog"
      ],
      "example": "v db selection explain sets/dd-bundle-selection.toml",
      "url": "/forge-reference/reference/db/db-selection-explain/"
    },
    {
